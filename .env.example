# ============================================================
# ApiEnvios - environment variables
# Copy this file to .env and fill in the values.
# Every value below is a placeholder: generate your own secrets.
# ============================================================

# --- APP ---
NODE_ENV=development
PORT=3000
# Machine-to-machine secret. The app refuses to start in production with the dev default.
API_SECRET=change-me-api-secret
# Public base URL used to build each instance's apiUrl and webhook URLs.
# With Docker Compose, use the service name (e.g. http://app:3000).
PUBLIC_BASE_URL=http://localhost:3000
# Public URL of the API and of the admin panel (used for docs examples and CORS).
PUBLIC_API_URL=http://localhost:3000
PUBLIC_PANEL_URL=http://localhost:3000

# --- HUMAN AUTH (JWT login) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d
# Idle session timeout (Redis). This is the effective expiry; JWT_EXPIRES_IN is
# only the absolute upper bound.
SESSION_IDLE_TIMEOUT_MIN=30

# --- DATABASE ---
# Password of the PostgreSQL user (used by docker-compose.example.yml and in the URLs below).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://apienvios:<POSTGRES_PASSWORD>@localhost:5432/apienvios"
# Used only by "prisma migrate *" (see directUrl in prisma/schema.prisma).
# Without a connection pooler in front of Postgres, use the same value as
# DATABASE_URL. With a transaction-mode pooler (e.g. PgBouncer), point this
# directly to Postgres.
DIRECT_DATABASE_URL="postgresql://apienvios:<POSTGRES_PASSWORD>@localhost:5432/apienvios"

# --- SECRET ENCRYPTION AT REST ---
# Master key (AES-256-GCM) that encrypts Instance.token, Instance.webhookSecret
# and ApiClient.apiKey in the database. Never commit it.
# Generate with: openssl rand -base64 32
# Without it, creating a new instance or tenant fails (nothing can be encrypted).
SECRETS_ENCRYPTION_KEY=

# --- REDIS (queues and cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- EVOLUTION API (provider 1) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

# --- WUZAPI (provider 2: Go/whatsmeow, interactive buttons) ---
WUZAPI_URL=http://localhost:8888
WUZAPI_ADMIN_TOKEN=

# --- WHATSAPP CLOUD API (provider 3: official, paid fallback) ---
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=

# --- AUDIO TRANSCRIPTION (MCP bridge; optional) ---
# Empty = inbound audio arrives without a transcription (Google Gemini API key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- MCP BRIDGE (see docs/mcp.md) ---
# MCP_BRIDGE_ENABLED=true
# Word that opens the "control chat" and prefix of every assistant reply.
# MCP_BRIDGE_TRIGGER_WORD=Claude
# MCP_BRIDGE_REPLY_PREFIX="Claude: "
# Replace the whole bridge text with your own (inline or from a file).
# MCP_BRIDGE_INSTRUCTIONS=
# MCP_BRIDGE_INSTRUCTIONS_FILE=

# --- SENDING / ANTI-BAN ---
SEND_DELAY_MIN=2000
SEND_DELAY_MAX=5000
MAX_MESSAGES_PER_NUMBER_DAY=200
SEND_WORKER_CONCURRENCY=5
SEND_QUEUE_LANES=1
DEFAULT_RATE_LIMIT=100

# --- LOGIN BRUTE-FORCE PROTECTION ---
LOGIN_MAX_TENTATIVAS_CONTA=5
LOGIN_JANELA_CONTA_MIN=15
LOGIN_MAX_TENTATIVAS_IP=20
LOGIN_JANELA_IP_MIN=15
LOGIN_MAX_TENTATIVAS_DISPOSITIVO=20
LOGIN_JANELA_DISPOSITIVO_MIN=15
# Comma-separated IPs that are never throttled (e.g. your office VPN).
LOGIN_IP_ALLOWLIST=

# --- ALERTS (optional) ---
BAN_WEBHOOK_URL=
ALERT_EMAIL=

# --- INITIAL PANEL ADMIN (optional; used by `npm run db:seed`) ---
# Both empty = no admin is created. Never commit real credentials.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrator
