# ============================================================
# ApiEnvios - variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# Todos os valores abaixo são placeholders: gere os seus próprios segredos.
# ============================================================

# --- APP ---
NODE_ENV=development
PORT=3000
# Segredo máquina a máquina. O app se recusa a iniciar em produção com o padrão de dev.
API_SECRET=change-me-api-secret
# URL base pública usada para montar o apiUrl de cada instância e as URLs de webhook.
# Com Docker Compose, use o nome do serviço (ex.: http://app:3000).
PUBLIC_BASE_URL=http://localhost:3000
# URL pública da API e do painel de administração (usada nos exemplos da documentação e no CORS).
PUBLIC_API_URL=http://localhost:3000
PUBLIC_PANEL_URL=http://localhost:3000

# --- AUTENTICAÇÃO HUMANA (login com JWT) ---
# Gere com: openssl rand -base64 48
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d
# Timeout de inatividade da sessão (Redis). É a expiração efetiva; JWT_EXPIRES_IN é
# apenas o limite absoluto.
SESSION_IDLE_TIMEOUT_MIN=30

# --- BANCO DE DADOS ---
# Senha do usuário do PostgreSQL (usada pelo docker-compose.example.yml e nas URLs abaixo).
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://apienvios:<POSTGRES_PASSWORD>@localhost:5432/apienvios"
# Usada apenas por "prisma migrate *" (veja directUrl em prisma/schema.prisma).
# Sem um pooler de conexões na frente do Postgres, use o mesmo valor de
# DATABASE_URL. Com um pooler em modo transação (ex.: PgBouncer), aponte
# diretamente para o Postgres.
DIRECT_DATABASE_URL="postgresql://apienvios:<POSTGRES_PASSWORD>@localhost:5432/apienvios"

# --- CRIPTOGRAFIA DE SEGREDOS EM REPOUSO ---
# Chave mestra (AES-256-GCM) que criptografa Instance.token, Instance.webhookSecret
# e ApiClient.apiKey no banco. Nunca faça commit dela.
# Gere com: openssl rand -base64 32
# Sem ela, a criação de uma nova instância ou tenant falha (nada pode ser criptografado).
SECRETS_ENCRYPTION_KEY=

# --- REDIS (filas e cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- EVOLUTION API (provedor 1) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

# --- WUZAPI (provedor 2: Go/whatsmeow, botões interativos) ---
WUZAPI_URL=http://localhost:8888
WUZAPI_ADMIN_TOKEN=

# --- WHATSAPP CLOUD API (provedor 3: oficial, fallback pago) ---
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=

# --- TRANSCRIÇÃO DE ÁUDIO (ponte do MCP; opcional) ---
# Vazio = os áudios recebidos chegam sem transcrição (chave da API do Google Gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- PONTE DO MCP (veja docs/mcp.md) ---
# MCP_BRIDGE_ENABLED=true
# Palavra que abre o "chat de controle" e prefixo de toda resposta do assistente.
# MCP_BRIDGE_TRIGGER_WORD=Claude
# MCP_BRIDGE_REPLY_PREFIX="Claude: "
# Substitui o texto inteiro da ponte pelo seu (direto aqui ou a partir de um arquivo).
# MCP_BRIDGE_INSTRUCTIONS=
# MCP_BRIDGE_INSTRUCTIONS_FILE=

# --- ENVIO / ANTI-BAN ---
SEND_DELAY_MIN=2000
SEND_DELAY_MAX=5000
MAX_MESSAGES_PER_NUMBER_DAY=200
SEND_WORKER_CONCURRENCY=5
SEND_QUEUE_LANES=1
DEFAULT_RATE_LIMIT=100

# --- PROTEÇÃO CONTRA FORÇA BRUTA NO LOGIN ---
LOGIN_MAX_TENTATIVAS_CONTA=5
LOGIN_JANELA_CONTA_MIN=15
LOGIN_MAX_TENTATIVAS_IP=20
LOGIN_JANELA_IP_MIN=15
LOGIN_MAX_TENTATIVAS_DISPOSITIVO=20
LOGIN_JANELA_DISPOSITIVO_MIN=15
# IPs separados por vírgula que nunca sofrem limitação (ex.: a VPN do seu escritório).
LOGIN_IP_ALLOWLIST=

# --- ALERTAS (opcional) ---
BAN_WEBHOOK_URL=
ALERT_EMAIL=

# --- ADMINISTRADOR INICIAL DO PAINEL (opcional; usado por `npm run db:seed`) ---
# Os dois vazios = nenhum administrador é criado. Nunca faça commit de credenciais reais.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrator
